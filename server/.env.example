# server/.env.example  (placeholders only — never commit real secrets)
DATABASE_URL=postgresql+psycopg://baseline:baseline@localhost:5432/baseline
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_MIN=60
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PAYLOAD_ENC_KEY=REPLACE_WITH_GENERATED_FERNET_KEY
CORS_ORIGINS=http://localhost:5173
ENABLE_AUTOENCODER=false
MODELS_DIR=./models_store
LOG_LEVEL=INFO
# Set false only for local bulk backfills (e.g. multi-month simulator runs)
RATE_LIMITS_ENABLED=true
